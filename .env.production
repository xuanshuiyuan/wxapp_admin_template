# ── 生产环境 ──────────────────────────────────────────────
# npm run build:* 时自动加载，优先级低于 .env.local

VITE_APP_ENV=production

# ⚠️ 上线前替换：小程序 / App 必须是 http(s) 绝对地址；H5 与后端同域时可留空走相对路径
VITE_HOST_MP=REPLACE_API_BASE_URL
VITE_HOST_H5=REPLACE_API_BASE_URL
VITE_HOST_APP=REPLACE_API_BASE_URL

VITE_OSS_HOST=REPLACE_OSS_HOST

# 签名密钥不进 git：VITE_API_KEY 写在 .env.production.local（已 gitignore），向后端线下领取
# ⚠️ 每个 source（1001 / 0101 / 1010）都有自己的密钥，不要混用

# 联调通道生产一律留空（后端也不接受 develop 头 / mock code）
# VITE_SOURCE=
# VITE_DEVELOP_BYPASS=
# VITE_MOCK_LOGIN_CODE=
