# ── 开发环境 ──────────────────────────────────────────────
# npm run dev:* 时自动加载，优先级低于 .env.local

VITE_APP_ENV=development

# 演示模式：登录/绑定不请求后端（详见 src/config/app.js 的注释）。生产必须为 false。
VITE_DEMO_MODE=true

# 接口地址：本地后端模板默认端口 15000（以 cmd/conf/local/logic.toml 的 [iris] Port 为准）
VITE_HOST_MP=http://localhost:15000/
VITE_HOST_H5=http://localhost:15000/
VITE_HOST_APP=

# OSS / CDN 资源域（图片只存相对路径，拼接见 utils/oss.js）；没有就留空
VITE_OSS_HOST=

# 签名密钥不进 git（后端 Verification.KeyList 里该 source 的 Key）：
# 写在 .env.development.local（.gitignore 已忽略），向后端线下领取。
# 本地/开发后端可用 VITE_DEVELOP_BYPASS=develop 跳过签名校验（见下）。

# ── 联调自测（可选，生产必须留空）──────────────────────────
# 打后端模板的 demo 模块（web 组，校验 C 端 source）时才需要：
# VITE_SOURCE=1010
# VITE_DEVELOP_BYPASS=develop
# 非微信端（H5）真实登录需要后端联调 mock code；后端未提供时留空（H5 会明确报错）
# VITE_MOCK_LOGIN_CODE=
